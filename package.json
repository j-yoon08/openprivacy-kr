{
  "name": "openprivacy-kr",
  "version": "0.2.0",
  "description": "우리 조직의 상황을 입력하면 개인정보 보호법·ISMS-P·ISO 27001 기준의 부족한 점과 개선 방법을 알려주는 로컬 우선 오픈소스 도구",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-yoon08/openprivacy-kr.git"
  },
  "bin": {
    "openprivacy-kr": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "catalog",
    "web",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "dev": "node src/cli.ts",
    "law:build": "node scripts/build-law.ts"
  },
  "keywords": [
    "pipa",
    "isms-p",
    "iso27001",
    "compliance",
    "grc",
    "privacy",
    "korea"
  ],
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
